<view class="container">
  <view class="login-box">
    <image class="logo" src="/images/icons/avatar.png"></image>
    <view class="title">家庭点餐系统</view>
    <view class="subtitle">享受便捷的家庭订餐体验</view>

    <!-- 显示调试信息 -->
    <view class="debug-info">
      <text>{{debugInfo}}</text>
    </view>

    <view class="timestamp">
      <text>时间: {{timestamp}}</text>
    </view>

    <button class="login-btn" bindtap="onLogin" disabled="{{loading}}">
      <image class="wechat-icon" src="/images/icons/usercenter.png"></image>
      微信一键登录
    </button>

    <view class="agreement">
      <!-- 点击登录即表示您同意我们的服务条款 -->
      <text class="agreement-text">登录即表示您已阅读并同意</text>
      <text class="agreement-link" bindtap="onAgreementTap">《用户协议》</text>
      <text class="agreement-text">和</text>
      <text class="agreement-link" bindtap="onPrivacyTap">《隐私政策》</text>
    </view>

    <view class="features">
      <view class="feature-item">
        <image class="feature-icon" src="/images/icons/home.png"></image>
        <text class="feature-text">每日精选菜单</text>
      </view>
      <view class="feature-item">
        <image class="feature-icon" src="/images/icons/business.png"></image>
        <text class="feature-text">轻松点餐下单</text>
      </view>
      <view class="feature-item">
        <image class="feature-icon" src="/images/icons/goods.png"></image>
        <text class="feature-text">订单历史查询</text>
      </view>
    </view>
  </view>

  <view class="footer">
    <text>© 2026 家庭点餐系统</text>
  </view>
</view>
<view class="login-page">
  <view class="login-bg">
    <view class="bg-emoji emoji-1">🍳</view>
    <view class="bg-emoji emoji-2">🥘</view>
    <view class="bg-emoji emoji-3">🧑‍🍳</view>
  </view>

  <view class="login-card">
    <view class="brand">
      <view class="brand-icon">🍳</view>
      <text class="brand-title">家庭食记</text>
      <text class="brand-sub">温暖每一餐</text>
    </view>

    <button class="wechat-btn" bindtap="onLogin" disabled="{{loading}}">
      <text wx:if="{{loading}}" class="btn-loading">登录中...</text>
      <text wx:else>微信一键登录</text>
    </button>

    <view class="features">
      <view class="feature">
        <text class="feature-emoji">📋</text>
        <text class="feature-text">每日菜单</text>
      </view>
      <view class="feature">
        <text class="feature-emoji">👍</text>
        <text class="feature-text">一键点餐</text>
      </view>
      <view class="feature">
        <text class="feature-emoji">📜</text>
        <text class="feature-text">历史记录</text>
      </view>
    </view>
  </view>

  <view class="footer">
    <text>登录即表示同意《用户协议》和《隐私政策》</text>
  </view>
</view>

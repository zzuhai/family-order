.login-page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  box-sizing: border-box;
  background: linear-gradient(180deg, #3D2C2E 0%, #5A484A 100%);
  position: relative;
  overflow: hidden;
}

.login-bg {
  position: absolute;
  inset: 0;
  pointer-events: none;
}

.bg-emoji {
  position: absolute;
  font-size: 120rpx;
  opacity: 0.06;
}

.emoji-1 { top: 10%; left: 10%; transform: rotate(-15deg); }
.emoji-2 { top: 55%; right: 8%; transform: rotate(20deg); font-size: 160rpx; }
.emoji-3 { bottom: 15%; left: 15%; transform: rotate(-5deg); }

.login-card {
  width: 100%;
  max-width: 560rpx;
  background: rgba(255, 255, 255, 0.96);
  backdrop-filter: blur(20px);
  border-radius: 32rpx;
  padding: 60rpx 40rpx 40rpx;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.2);
  position: relative;
  z-index: 1;
}

.brand {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 50rpx;
}

.brand-icon {
  font-size: 72rpx;
  margin-bottom: 16rpx;
}

.brand-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #3D2C2E;
  letter-spacing: 6rpx;
}

.brand-sub {
  font-size: 24rpx;
  color: #8A7A7B;
  letter-spacing: 4rpx;
  margin-top: 8rpx;
}

.wechat-btn {
  width: 100%;
  height: 90rpx;
  line-height: 90rpx;
  background: linear-gradient(135deg, #D4764A, #B85E34);
  color: #fff;
  border-radius: 45rpx;
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: 4rpx;
  border: none;
  padding: 0;
  margin-bottom: 40rpx;
  box-shadow: 0 8rpx 24rpx rgba(212, 118, 74, 0.3);
}

.wechat-btn:active {
  opacity: 0.85;
}

.wechat-btn[disabled] {
  opacity: 0.6;
}

.btn-loading {
  font-size: 28rpx;
  opacity: 0.8;
}

.features {
  display: flex;
  justify-content: space-around;
  padding: 0 20rpx;
}

.feature {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
}

.feature-emoji {
  font-size: 44rpx;
}

.feature-text {
  font-size: 24rpx;
  color: #8A7A7B;
}

.footer {
  position: absolute;
  bottom: 60rpx;
  left: 0;
  right: 0;
  text-align: center;
  z-index: 1;
}

.footer text {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.5);
  letter-spacing: 1rpx;
}

.page {
  min-height: 100vh;
  padding: 30rpx 24rpx 140rpx;
  box-sizing: border-box;
}

/* --- Header --- */
.page-header {
  text-align: center;
  margin-bottom: 30rpx;
  padding: 24rpx;
  background: linear-gradient(135deg, #3D2C2E, #5A484A);
  border-radius: 20rpx;
}

.header-label {
  font-size: 36rpx;
  font-weight: 700;
  color: #FFF8F0;
  letter-spacing: 4rpx;
}

.header-date {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 248, 240, 0.6);
  margin-top: 8rpx;
}

/* --- Menu List --- */
.menu-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.menu-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(61, 44, 46, 0.04);
  display: flex;
  align-items: center;
  justify-content: space-between;
  position: relative;
  transition: all 0.2s;
  border: 2rpx solid transparent;
}

.menu-card:active {
  transform: scale(0.98);
}

.menu-card.selected {
  border-color: #D4764A;
  background: #FFF8F0;
}

.menu-card-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
  flex: 1;
  min-width: 0;
}

.menu-thumb {
  width: 120rpx;
  height: 120rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
}

.menu-thumb-placeholder {
  width: 120rpx;
  height: 120rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #F5D4B8, #E8A87C);
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.menu-thumb-placeholder text {
  font-size: 44rpx;
  font-weight: 700;
  color: #fff;
}

.menu-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.menu-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #3D2C2E;
}

.menu-desc {
  font-size: 24rpx;
  color: #8A7A7B;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  line-height: 1.4;
}

.menu-check {
  width: 40rpx;
  height: 40rpx;
  background: #D4764A;
  color: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: bold;
  flex-shrink: 0;
  margin-left: 12rpx;
}

/* --- Submit --- */
.submit-wrap {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 30rpx 30rpx;
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(10px);
  border-top: 1rpx solid #F0E8E0;
}

.ordered-banner {
  text-align: center;
  padding: 40rpx 0;
  color: #D4764A;
  font-size: 28rpx;
  font-weight: 600;
}

/* Empty State */
.empty-state {
  text-align: center;
  padding: 120rpx 0;
  color: #8A7A7B;
  font-size: 28rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.empty-emoji {
  font-size: 64rpx;
}

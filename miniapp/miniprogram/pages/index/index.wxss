/**index.wxss**/
page {
  background-color: #f5f5f5;
  color: #333;
}

.container {
  padding: 20rpx;
}

.header {
  margin-bottom: 30rpx;
  text-align: center;
}

.date {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 10rpx;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  color: #545c64;
}

.loading, .empty {
  text-align: center;
  padding: 100rpx 0;
  color: #999;
}

.menu-list {
  margin-bottom: 120rpx;
}

.menu-item {
  background: white;
  margin-bottom: 20rpx;
  padding: 30rpx;
  border-radius: 10rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
  position: relative;
  transition: all 0.3s;
}

.menu-item.selected {
  background: #f0f9eb;
  border: 2rpx solid #545c64;
}

.menu-content {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.menu-info {
  flex: 1;
}

.menu-name {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.menu-desc {
  font-size: 28rpx;
  color: #666;
}

.menu-image {
  width: 120rpx;
  height: 120rpx;
  margin-left: 20rpx;
  border-radius: 10rpx;
  overflow: hidden;
}

.menu-image image {
  width: 100%;
  height: 100%;
}

.select-icon {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  width: 40rpx;
  height: 40rpx;
  background: #545c64;
  color: white;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
}

.submit-area {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx;
  background: white;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.1);
}

.submit-btn {
  background: #545c64;
  color: white;
  border-radius: 50rpx;
  font-size: 32rpx;
}

.has-order {
  text-align: center;
  padding: 50rpx 0;
  color: #545c64;
  font-weight: bold;
}
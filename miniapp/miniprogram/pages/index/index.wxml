<view class="page">
  <!-- 日期头部 -->
  <view class="page-header">
    <text class="header-label">今日菜单</text>
    <text class="header-date">{{date}}</text>
  </view>

  <view wx:if="{{loading}}" class="loading">加载中...</view>

  <view wx:elif="{{menus.length > 0}}" class="menu-list">
    <view
      wx:for="{{menus}}"
      wx:key="id"
      class="menu-card {{item.selected ? 'selected' : ''}}"
      bindtap="toggleSelect"
      data-index="{{index}}"
    >
      <view class="menu-card-left">
        <image
          wx:if="{{item.dishImageUrl}}"
          class="menu-thumb"
          src="{{item.dishImageUrl}}"
          mode="aspectFill"
        />
        <view wx:else class="menu-thumb-placeholder">
          <text>{{item.dishName.charAt(0)}}</text>
        </view>
        <view class="menu-info">
          <text class="menu-name">{{item.dishName}}</text>
          <text class="menu-desc">{{item.dishDescription}}</text>
        </view>
      </view>
      <view wx:if="{{item.selected}}" class="menu-check">✓</view>
    </view>
  </view>

  <view wx:else class="empty-state">
    <text class="empty-emoji">📭</text>
    <text>今日暂无菜单</text>
  </view>

  <view wx:if="{{!hasOrder && menus.length > 0}}" class="submit-wrap">
    <button class="btn-primary" bindtap="submitOrder">提交订单</button>
  </view>

  <view wx:elif="{{hasOrder}}" class="ordered-banner">
    <text>✅ 今日已点餐</text>
  </view>
</view>

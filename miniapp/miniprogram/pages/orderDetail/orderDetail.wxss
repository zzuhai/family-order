page {
  background-color: #f5f5f5;
}

.container {
  min-height: 100vh;
  padding-bottom: 40rpx;
}

.loading {
  text-align: center;
  padding: 100rpx;
  color: #999;
}

.detail-container {
  padding: 20rpx;
}

/* 订单头部 */
.order-header {
  background-color: #fff;
  padding: 30rpx;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.header-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 15rpx;
}

.order-date {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.order-status {
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
}

.order-status.submitted {
  background-color: #fff3e0;
  color: #f57c00;
}

.order-status.preparing {
  background-color: #e3f2fd;
  color: #1976d2;
}

.order-status.completed {
  background-color: #e8f5e9;
  color: #388e3c;
}

.order-time {
  font-size: 24rpx;
  color: #999;
}

/* 菜品区域 */
.dish-section {
  background-color: #fff;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.dish-header {
  display: flex;
  align-items: center;
  padding: 30rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}

.dish-image {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  margin-right: 20rpx;
  border: 3rpx solid rgba(255, 255, 255, 0.3);
}

.dish-title-wrap {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.dish-name {
  font-size: 36rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 8rpx;
}

.dish-category {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* 区块 */
.section {
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.section:last-child {
  border-bottom: none;
}

.section-title {
  display: flex;
  align-items: center;
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.title-icon {
  font-size: 36rpx;
  margin-right: 10rpx;
}

/* 材料列表 */
.ingredient-list {
  display: flex;
  flex-direction: column;
  gap: 15rpx;
}

.ingredient-item {
  display: flex;
  align-items: center;
  padding: 15rpx 20rpx;
  background-color: #f8f9fa;
  border-radius: 8rpx;
}

.ingredient-dot {
  width: 12rpx;
  height: 12rpx;
  background-color: #667eea;
  border-radius: 50%;
  margin-right: 15rpx;
}

.ingredient-name {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.ingredient-amount {
  font-size: 26rpx;
  color: #666;
  font-weight: 500;
}

/* 制作步骤 */
.step-list {
  display: flex;
  flex-direction: column;
  gap: 25rpx;
}

.step-item {
  display: flex;
  gap: 15rpx;
}

.step-number {
  width: 56rpx;
  height: 56rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: bold;
  flex-shrink: 0;
}

.step-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 15rpx;
}

.step-text {
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
  padding-top: 4rpx;
}

.step-image {
  width: 100%;
  height: 300rpx;
  border-radius: 12rpx;
  background-color: #f0f0f0;
}

/* 空状态 */
.empty-tip {
  text-align: center;
  padding: 40rpx 0;
  color: #999;
  font-size: 26rpx;
}

/* 底部提示 */
.footer-tip {
  text-align: center;
  padding: 40rpx 0;
  color: #999;
  font-size: 26rpx;
}

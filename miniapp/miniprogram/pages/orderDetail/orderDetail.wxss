.page {
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
}

.detail-page {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

/* --- Header --- */
.detail-header {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 28rpx 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(61, 44, 46, 0.04);
}

.header-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 12rpx;
}

.header-date-wrap {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.header-date {
  font-size: 34rpx;
  font-weight: 700;
  color: #3D2C2E;
}

.header-label {
  font-size: 22rpx;
  color: #8A7A7B;
}

.header-time {
  font-size: 22rpx;
  color: #8A7A7B;
}

/* --- Dish Block --- */
.dish-block {
  background: #FFFFFF;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(61, 44, 46, 0.04);
}

.dish-block-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx;
  background: linear-gradient(135deg, #3D2C2E, #5A484A);
}

.block-dish-image {
  width: 100rpx;
  height: 100rpx;
  border-radius: 14rpx;
  border: 3rpx solid rgba(255, 255, 255, 0.2);
  flex-shrink: 0;
}

.block-dish-placeholder {
  width: 100rpx;
  height: 100rpx;
  border-radius: 14rpx;
  background: linear-gradient(135deg, #D4764A, #E8A87C);
  border: 3rpx solid rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.block-dish-placeholder text {
  font-size: 40rpx;
  font-weight: 700;
  color: #fff;
}

.block-dish-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.block-dish-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #FFF8F0;
}

.block-dish-category {
  font-size: 22rpx;
  color: rgba(255, 248, 240, 0.6);
}

/* --- Sections --- */
.block-section {
  padding: 24rpx;
  border-bottom: 1rpx solid #F0E8E0;
}

.block-section:last-child {
  border-bottom: none;
}

.section-title {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #3D2C2E;
  margin-bottom: 16rpx;
}

.section-icon {
  font-size: 32rpx;
}

/* --- Ingredients --- */
.ingredient-grid {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.ingredient-item {
  display: flex;
  align-items: center;
  padding: 14rpx 18rpx;
  background: #FFF8F0;
  border-radius: 12rpx;
}

.ingredient-dot {
  width: 10rpx;
  height: 10rpx;
  background: #D4764A;
  border-radius: 50%;
  margin-right: 14rpx;
  flex-shrink: 0;
}

.ingredient-name {
  flex: 1;
  font-size: 26rpx;
  color: #3D2C2E;
}

.ingredient-amount {
  font-size: 24rpx;
  color: #8A7A7B;
  font-weight: 500;
}

/* --- Steps --- */
.step-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.step-item {
  display: flex;
  gap: 16rpx;
}

.step-number {
  width: 48rpx;
  height: 48rpx;
  background: linear-gradient(135deg, #D4764A, #E8A87C);
  color: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: bold;
  flex-shrink: 0;
}

.step-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  padding-top: 4rpx;
}

.step-text {
  font-size: 26rpx;
  color: #3D2C2E;
  line-height: 1.6;
}

.step-image {
  width: 100%;
  height: 280rpx;
  border-radius: 14rpx;
  background: #F0E8E0;
}

/* --- Empty --- */
.block-empty {
  text-align: center;
  padding: 30rpx 0;
  color: #8A7A7B;
  font-size: 24rpx;
}

/* --- Footer --- */
.footer-count {
  text-align: center;
  padding: 30rpx 0;
  color: #8A7A7B;
  font-size: 24rpx;
}

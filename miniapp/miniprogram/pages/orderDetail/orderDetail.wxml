<view class="container">
  <!-- 加载状态 -->
  <view wx:if="{{loading}}" class="loading">
    <text>加载中...</text>
  </view>

  <!-- 订单详情 -->
  <view wx:else class="detail-container">
    <!-- 订单信息头部 -->
    <view class="order-header">
      <view class="header-row">
        <text class="order-date">{{order.menuDate}}</text>
        <view class="order-status {{order.status}}">
          <text>{{statusText}}</text>
        </view>
      </view>
      <text class="order-time">下单时间：{{order.createdAt}}</text>
    </view>

    <!-- 菜品列表 -->
    <view wx:for="{{order.items}}" wx:key="id" class="dish-section">
      <!-- 菜品标题 -->
      <view class="dish-header">
        <image wx:if="{{item.dishImageUrl}}" class="dish-image" src="{{item.dishImageUrl}}" mode="aspectFill" />
        <view class="dish-title-wrap">
          <text class="dish-name">{{item.dishName}}</text>
          <text class="dish-category">{{item.category}}</text>
        </view>
      </view>

      <!-- 所需材料 -->
      <view class="section">
        <view class="section-title">
          <text class="title-icon">📋</text>
          <text>所需材料</text>
        </view>
        <view wx:if="{{item.ingredients && item.ingredients.length > 0}}" class="ingredient-list">
          <view wx:for="{{item.ingredients}}" wx:for-item="ingredient" wx:key="id" class="ingredient-item">
            <view class="ingredient-dot"></view>
            <text class="ingredient-name">{{ingredient.name}}</text>
            <text class="ingredient-amount">{{ingredient.amount}}{{ingredient.unit}}</text>
          </view>
        </view>
        <view wx:else class="empty-tip">暂无材料信息</view>
      </view>

      <!-- 制作步骤 -->
      <view class="section">
        <view class="section-title">
          <text class="title-icon">👨‍🍳</text>
          <text>制作步骤</text>
        </view>
        <view wx:if="{{item.steps && item.steps.length > 0}}" class="step-list">
          <view wx:for="{{item.steps}}" wx:for-item="step" wx:key="id" class="step-item">
            <view class="step-number">{{step.stepNumber}}</view>
            <view class="step-content">
              <text class="step-text">{{step.description}}</text>
              <image wx:if="{{step.imageUrl}}" class="step-image" src="{{step.imageUrl}}" mode="aspectFill" />
            </view>
          </view>
        </view>
        <view wx:else class="empty-tip">暂无制作步骤</view>
      </view>
    </view>

    <!-- 底部提示 -->
    <view class="footer-tip">
      <text>共 {{order.items.length}} 道菜</text>
    </view>
  </view>
</view>

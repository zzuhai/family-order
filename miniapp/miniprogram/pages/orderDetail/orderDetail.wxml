<view class="page">
  <view wx:if="{{loading}}" class="loading">加载中...</view>

  <view wx:else class="detail-page">
    <!-- 订单头部 -->
    <view class="detail-header">
      <view class="header-top">
        <view class="header-date-wrap">
          <text class="header-date">{{order.menuDate}}</text>
          <text class="header-label">订单详情</text>
        </view>
        <view class="tag tag-{{order.status}}">
          <text>{{statusText}}</text>
        </view>
      </view>
      <text class="header-time">下单时间：{{order.createdAt}}</text>
    </view>

    <!-- 每道菜品区域 -->
    <view wx:for="{{order.items}}" wx:key="id" class="dish-block">
      <view class="dish-block-header">
        <image wx:if="{{item.dishImageUrl}}" class="block-dish-image" src="{{item.dishImageUrl}}" mode="aspectFill" />
        <view wx:else class="block-dish-placeholder">
          <text>{{item.dishName.charAt(0)}}</text>
        </view>
        <view class="block-dish-info">
          <text class="block-dish-name">{{item.dishName}}</text>
          <text wx:if="{{item.category}}" class="block-dish-category">{{item.category}}</text>
        </view>
      </view>

      <!-- 材料 -->
      <view class="block-section">
        <view class="section-title">
          <text class="section-icon">📋</text>
          <text>所需材料</text>
        </view>
        <view wx:if="{{item.ingredients && item.ingredients.length > 0}}" class="ingredient-grid">
          <view wx:for="{{item.ingredients}}" wx:for-item="ing" wx:key="id" class="ingredient-item">
            <view class="ingredient-dot"></view>
            <text class="ingredient-name">{{ing.name}}</text>
            <text class="ingredient-amount">{{ing.amount}}{{ing.unit}}</text>
          </view>
        </view>
        <view wx:else class="block-empty">暂无材料信息</view>
      </view>

      <!-- 步骤 -->
      <view class="block-section">
        <view class="section-title">
          <text class="section-icon">👨‍🍳</text>
          <text>制作步骤</text>
        </view>
        <view wx:if="{{item.steps && item.steps.length > 0}}" class="step-list">
          <view wx:for="{{item.steps}}" wx:for-item="step" wx:key="id" class="step-item">
            <view class="step-number">{{step.stepNumber}}</view>
            <view class="step-content">
              <text class="step-text">{{step.description}}</text>
              <image wx:if="{{step.imageUrl}}" class="step-image" src="{{step.imageUrl}}" mode="aspectFill" />
            </view>
          </view>
        </view>
        <view wx:else class="block-empty">暂无制作步骤</view>
      </view>
    </view>

    <view class="footer-count">
      <text>共 {{order.items.length}} 道菜品</text>
    </view>
  </view>
</view>

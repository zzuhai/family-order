<view class="container">
  <!-- 加载状态 -->
  <view wx:if="{{loading}}" class="loading">
    <text>加载中...</text>
  </view>

  <!-- 菜单主体 -->
  <view wx:else class="menu-container">
    <!-- 左侧分类 -->
    <scroll-view class="category-sidebar" scroll-y>
      <view
        wx:for="{{categories}}"
        wx:key="index"
        class="category-item {{selectedCategoryIndex === index ? 'active' : ''}}"
        bindtap="selectCategory"
        data-index="{{index}}"
      >
        <text>{{item}}</text>
      </view>
    </scroll-view>

    <!-- 右侧菜品列表 -->
    <scroll-view class="dish-content" scroll-y>
      <view wx:if="{{filteredDishes.length > 0}}" class="dish-list">
        <view
          wx:for="{{filteredDishes}}"
          wx:key="id"
          class="dish-item {{item.selected ? 'selected' : ''}}"
          bindtap="toggleSelect"
          data-dish-id="{{item.id}}"
        >
          <image
            wx:if="{{item.imageUrl}}"
            class="dish-image"
            src="{{item.imageUrl}}"
            mode="aspectFill"
          />
          <image
            wx:else
            class="dish-image dish-image-placeholder"
            src="/images/placeholder.png"
            mode="aspectFill"
          />
          <text class="dish-name">{{item.name}}</text>
          <view wx:if="{{item.selected}}" class="select-badge">✓</view>
        </view>
      </view>

      <!-- 空状态 -->
      <view wx:else class="empty-state">
        <text>暂无菜品</text>
      </view>
    </scroll-view>
  </view>

  <!-- 底部提交按钮 -->
  <view class="submit-bar">
    <view class="selected-count">已选 {{selectedCount}} 道菜</view>
    <button class="submit-btn" bindtap="submitOrder" disabled="{{selectedCount === 0}}">提交订单</button>
  </view>
</view>
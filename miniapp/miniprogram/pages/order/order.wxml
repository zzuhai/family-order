<view class="page">
  <view wx:if="{{loading}}" class="loading">加载菜品中...</view>

  <view wx:else class="order-page">
    <!-- 左侧分类 + 右侧菜品 -->
    <view class="main-content">
      <!-- 左侧分类导航 -->
      <scroll-view class="category-sidebar" scroll-y show-scrollbar="{{false}}" enhanced>
        <view
          wx:for="{{categories}}"
          wx:key="index"
          class="category-item {{selectedCategoryIndex === index ? 'active' : ''}}"
          bindtap="selectCategory"
          data-index="{{index}}"
        >
          <text>{{item}}</text>
        </view>
      </scroll-view>

      <!-- 右侧菜品列表 -->
      <scroll-view class="dish-scroll" scroll-y show-scrollbar="{{false}}" enhanced>
        <view wx:if="{{filteredDishes.length > 0}}" class="dish-list">
          <view
            wx:for="{{filteredDishes}}"
            wx:key="id"
            class="dish-item {{item.selected ? 'selected' : ''}}"
            bindtap="toggleSelect"
            data-dish-id="{{item.id}}"
          >
            <view class="dish-image-wrap">
              <image
                wx:if="{{item.imageUrl}}"
                class="dish-image"
                src="{{item.imageUrl}}"
                mode="aspectFill"
              />
              <view wx:else class="dish-image-placeholder">
                <text>{{item.name.charAt(0)}}</text>
              </view>
            </view>
            <view class="dish-info">
              <text class="dish-name">{{item.name}}</text>
              <text class="dish-desc">{{item.description}}</text>
            </view>
            <view wx:if="{{item.selected}}" class="selected-badge">✓</view>
          </view>
        </view>
        <view wx:else class="empty-state">暂无菜品</view>
      </scroll-view>
    </view>
  </view>

  <!-- 底部栏 -->
  <view class="bottom-bar">
    <view class="cart-info">
      <text class="cart-emoji">🍽️</text>
      <text class="cart-text">已选 {{selectedCount}} 道菜</text>
    </view>
    <button class="submit-btn" disabled="{{selectedCount === 0}}" bindtap="submitOrder">提交订单</button>
  </view>
</view>

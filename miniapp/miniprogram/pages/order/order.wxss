.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.order-page {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  padding-bottom: 110rpx;
}

/* --- Main Content (sidebar + dish list) --- */
.main-content {
  flex: 1;
  display: flex;
  overflow: hidden;
}

/* --- Left Sidebar --- */
.category-sidebar {
  width: 180rpx;
  background: #F8F2EC;
  overflow-y: scroll;
  -webkit-overflow-scrolling: touch;
  flex-shrink: 0;
}

.category-item {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100rpx;
  font-size: 26rpx;
  color: #5A484A;
  border-left: 4rpx solid transparent;
  transition: all 0.2s;
  position: relative;
}

.category-item:active {
  background: rgba(212, 118, 74, 0.08);
}

.category-item.active {
  background: #FFF8F0;
  color: #D4764A;
  font-weight: 600;
  border-left-color: #D4764A;
}

/* --- Right Dish List --- */
.dish-scroll {
  flex: 1;
  overflow-y: scroll;
  -webkit-overflow-scrolling: touch;
  padding: 16rpx;
  background: #FFF8F0;
}

.dish-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.dish-item {
  background: #FFFFFF;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(61, 44, 46, 0.04);
  display: flex;
  align-items: center;
  padding: 16rpx;
  gap: 16rpx;
  position: relative;
  border: 2rpx solid transparent;
  transition: all 0.2s;
}

.dish-item:active {
  transform: scale(0.98);
}

.dish-item.selected {
  border-color: #D4764A;
  background: #FFFDF8;
  box-shadow: 0 4rpx 16rpx rgba(212, 118, 74, 0.12);
}

.dish-image-wrap {
  width: 140rpx;
  height: 140rpx;
  border-radius: 12rpx;
  overflow: hidden;
  flex-shrink: 0;
}

.dish-image {
  width: 100%;
  height: 100%;
  display: block;
}

.dish-image-placeholder {
  width: 100%;
  height: 100%;
  background: linear-gradient(135deg, #F5D4B8, #E8A87C);
  display: flex;
  align-items: center;
  justify-content: center;
}

.dish-image-placeholder text {
  font-size: 40rpx;
  font-weight: 700;
  color: #fff;
}

.dish-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  min-width: 0;
}

.dish-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #3D2C2E;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.dish-desc {
  font-size: 22rpx;
  color: #8A7A7B;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.selected-badge {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  width: 40rpx;
  height: 40rpx;
  background: #D4764A;
  color: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: bold;
  box-shadow: 0 2rpx 8rpx rgba(212, 118, 74, 0.3);
  animation: popIn 0.2s ease;
}

@keyframes popIn {
  0% { transform: scale(0); }
  50% { transform: scale(1.2); }
  100% { transform: scale(1); }
}

/* --- Bottom Bar --- */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 110rpx;
  background: rgba(255, 255, 255, 0.96);
  backdrop-filter: blur(10px);
  border-top: 1rpx solid #F0E8E0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx 0 30rpx;
  z-index: 100;
}

.cart-info {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.cart-emoji {
  font-size: 36rpx;
}

.cart-text {
  font-size: 26rpx;
  color: #3D2C2E;
  font-weight: 500;
}

.submit-btn {
  width: 200rpx;
  height: 76rpx;
  line-height: 76rpx;
  background: linear-gradient(135deg, #D4764A, #B85E34);
  color: #fff;
  border-radius: 38rpx;
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  border: none;
  padding: 0;
  transition: opacity 0.2s;
}

.submit-btn:active {
  opacity: 0.85;
}

.submit-btn[disabled] {
  background: #ccc;
  color: #999;
}

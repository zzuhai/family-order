.page {
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
}

.page-header {
  margin-bottom: 24rpx;
}

.header-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #3D2C2E;
  letter-spacing: 2rpx;
}

/* --- Order List --- */
.order-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.order-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(61, 44, 46, 0.04);
  transition: all 0.2s;
}

.order-card:active {
  transform: scale(0.98);
}

.order-card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #F0E8E0;
}

.order-date-wrap {
  display: flex;
  align-items: baseline;
  gap: 10rpx;
}

.order-date {
  font-size: 30rpx;
  font-weight: 700;
  color: #3D2C2E;
}

.order-day {
  font-size: 22rpx;
  color: #8A7A7B;
}

.order-status {
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.tag-submitted {
  background: #FFF3E0;
  color: #D4764A;
}

.tag-preparing {
  background: #E8F0FE;
  color: #7A8B5E;
}

.tag-completed {
  background: #E8F5E9;
  color: #388E3C;
}

/* --- Dishes Row --- */
.order-dishes {
  padding: 16rpx 0;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.order-dish-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 6rpx 14rpx 6rpx 6rpx;
  background: #FFF8F0;
  border-radius: 30rpx;
}

.dish-icon {
  width: 44rpx;
  height: 44rpx;
  border-radius: 22rpx;
  flex-shrink: 0;
}

.dish-icon-placeholder {
  width: 44rpx;
  height: 44rpx;
  border-radius: 22rpx;
  background: linear-gradient(135deg, #F5D4B8, #E8A87C);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.dish-icon-placeholder text {
  font-size: 20rpx;
  font-weight: 700;
  color: #fff;
}

.dish-label {
  font-size: 24rpx;
  color: #3D2C2E;
}

/* --- Footer --- */
.order-card-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 12rpx;
  border-top: 1rpx solid #F0E8E0;
}

.order-time {
  font-size: 22rpx;
  color: #8A7A7B;
}

.view-link {
  font-size: 24rpx;
  color: #D4764A;
  font-weight: 500;
}

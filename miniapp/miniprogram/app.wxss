/* ========================================
   家庭食记 · 小程序设计系统
   Warm Kitchen Theme
   ======================================== */

page {
  background: #FFF8F0;
  color: #3D2C2E;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Microsoft YaHei', sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
}

.container {
  min-height: 100vh;
  box-sizing: border-box;
}

/* Loading & Empty */
.loading {
  text-align: center;
  padding: 100rpx 0;
  color: #8A7A7B;
  font-size: 28rpx;
}

.empty-state {
  text-align: center;
  padding: 120rpx 0;
  color: #8A7A7B;
  font-size: 28rpx;
}

/* Card Base */
.card {
  background: #FFFFFF;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(61, 44, 46, 0.04);
}

/* Tag */
.tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.tag-submitted {
  background: #FFF3E0;
  color: #D4764A;
}

.tag-preparing {
  background: #E8F0FE;
  color: #7A8B5E;
}

.tag-completed {
  background: #E8F5E9;
  color: #388E3C;
}

/* Submit Button */
.btn-primary {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: linear-gradient(135deg, #D4764A, #B85E34);
  color: #fff;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  border: none;
  padding: 0;
  transition: opacity 0.2s;
}

.btn-primary:active {
  opacity: 0.85;
}

.btn-primary[disabled] {
  background: #ccc;
  color: #999;
}

/* Badge */
.badge {
  position: absolute;
  top: 10rpx;
  right: 10rpx;
  width: 44rpx;
  height: 44rpx;
  background: #D4764A;
  color: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: bold;
  box-shadow: 0 2rpx 8rpx rgba(212, 118, 74, 0.3);
}

/* Bottom Bar */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 110rpx;
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(10px);
  border-top: 1rpx solid #F0E8E0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 30rpx;
  z-index: 100;
}

/* Scrollbar */
::-webkit-scrollbar {
  width: 0;
  height: 0;
}
